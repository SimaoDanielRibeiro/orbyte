{
  "name": "ml-lab-web",
  "private": true,
  "version": "0.1.0",
  "description": "A interface do Orbyte (fase 10): React, TypeScript e Vite, a falar com a API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api": "openapi-ts",
    "predev": "npm run api",
    "dev": "vite",
    "prebuild": "npm run api",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run api && npm run lint && npm run typecheck && npm test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
