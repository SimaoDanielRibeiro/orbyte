# Copia este ficheiro para .env e tira o # das linhas que quiseres mudar.
# O .env não vai para o Git. Prioridade: variáveis de ambiente > .env > valores por omissão.
# Caminhos relativos partem da raiz do projeto. Uma variável ML_LAB_* desconhecida é um erro.

# Pasta dos datasets carregados pelo utilizador.
# ML_LAB_UPLOADS_DIR=data/uploads

# Pasta dos modelos treinados e dos snapshots.
# ML_LAB_ARTIFACTS_DIR=artifacts

# Ficheiro SQLite do registo de experiências (por omissão, dentro da pasta de artefactos).
# ML_LAB_DATABASE_PATH=artifacts/ml_lab.db

# Nível mínimo dos logs: DEBUG, INFO, WARNING, ERROR ou CRITICAL.
# ML_LAB_LOG_LEVEL=INFO

# Formato dos logs: text (para ler no terminal) ou json (logs estruturados).
# ML_LAB_LOG_FORMAT=text

# Onde a API escuta. 127.0.0.1 = só este computador (o ML Lab não tem autenticação).
# ML_LAB_API_HOST=127.0.0.1

# Porta da API (a documentação fica em http://127.0.0.1:8000/docs).
# ML_LAB_API_PORT=8000

# Páginas que podem chamar a API a partir do navegador, separadas por vírgulas.
# Por omissão, o servidor do Vite onde corre a interface aprimorada (fase 10).
# ML_LAB_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
